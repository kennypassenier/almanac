# systemd unit for Almanac (AR20).
#
# systemd rather than Docker because M10's self-update replaces the
# running binary: inside a container that write lands in the writable
# layer and is silently discarded on the next container recreation,
# putting the service back on the pinned image version — which then
# updates itself again, forever. The compose file next to this unit is
# for the future homelab-v2 migration, where homelab owns updates and
# self-update disables itself.
#
# Install:
#   sudo cp deploy/almanac.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now almanac

[Unit]
Description=Almanac — event-to-calendar hub
Documentation=https://github.com/kennypassenier/almanac
# Wants= rather than Requires=: if the network is slow to come up
# after a power cut, Almanac retries its first Google call on its own
# (AR21) rather than failing to start.
Wants=network-online.target
After=network-online.target

# No start limit (AR21). A power cut can start Almanac before DNS is
# up; systemd's default five-tries-in-ten-seconds would then park the
# unit in `failed` permanently with nobody watching. Almanac's own
# startup retry handles transient failures and a genuinely broken key
# still exits — this only makes sure a restartable process keeps being
# restarted.
#
# It lives in [Unit], not [Service]. systemd silently ignores it in
# [Service] with "Unknown key", which is how the first deployment of
# this file ran for a few minutes with the protection AR21 exists for
# not actually in effect.
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=exec
User=almanac
Group=almanac
WorkingDirectory=/opt/almanac

# Latch injects the five secrets straight into the process (AR8), so
# nothing lands on disk as plaintext. The key that opens Latch's store
# does live here, in a root-owned 0600 file — unavoidable for an
# unattended restart, and a conscious, recorded limitation.
#
# LATCH_KEY_ALMANAC (the per-project key) rather than LATCH_PASSPHRASE
# (Kenny, after consulting the Latch project, 2026-08-28): the
# passphrase would open every project's secrets and the GitHub token;
# the project key opens only Almanac's five values. If this LXC ever
# leaks, the blast radius is one project instead of everything.
EnvironmentFile=/etc/almanac/latch.env

# Where releases are published. An address, not a secret. Leaving it
# out is a supported configuration: self-update simply stays off and
# versions are installed by hand.
Environment=ALMANAC_UPDATE_URL=https://github.com/kennypassenier/almanac/releases

# ALMANAC_NOTIFY_WEBHOOK is NOT set here on purpose. A Home Assistant
# webhook id is a bearer credential for triggering that automation —
# its random suffix is the only thing protecting it — and this
# repository is public, so anything written here is published. It
# comes from Latch with the other secrets, via the EnvironmentFile
# above.
Environment=ALMANAC_PROFILES_DIR=/opt/almanac/profiles
Environment=ALMANAC_DATA_DIR=/opt/almanac/data
Environment=ALMANAC_JOURNAL=/opt/almanac/data/journal.jsonl
Environment=ALMANAC_TOKEN_STORE=/opt/almanac/data/tokens.json

ExecStart=/usr/local/bin/latch run -- /opt/almanac/almanac

Restart=always
RestartSec=5s

# M2's graceful shutdown drains in-flight requests and the worker
# before exiting; give it room rather than SIGKILLing mid-delivery.
KillSignal=SIGTERM
TimeoutStopSec=60

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# The whole install directory, not just data/ — M10's self-update
# writes the new binary next to the running one and keeps the replaced
# one beside it for AR23's revert. With only data/ writable the update
# would verify, download, and then fail at the swap on every single
# check, forever.
ReadWritePaths=/opt/almanac
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
