# Almanac's actual environment-variable contract (fixes INVENTORY.md
# AUTH-1: the old file, auto-generated from whatever Infisical held,
# listed 10 keys while the code only ever read 3). Run `almanac --help`
# for the same list next to the chassis-rs knobs.
#
# Two groups, and the difference matters for where they live:
#
#   Secrets      — injected by Latch (AR8), never written to disk:
#                    latch run -- ./target/release/almanac
#   Addresses    — plain configuration, set in the systemd unit
#                  (deploy/almanac.service) or the compose file.
#
# This file exists as a reference for what each one is, and as a
# convenience for exporting them by hand during local development.


# ---------------------------------------------------------------- #
# Secrets — Latch's job. Never commit real values.                  #
# ---------------------------------------------------------------- #

# Service account email — becomes the JWT "iss" claim.
CLIENT_EMAIL=

# RSA private key, PEM format, from the Google service-account JSON.
PRIVATE_KEY=

# Google's OAuth2 token endpoint. Almost always:
TOKEN_URI=https://oauth2.googleapis.com/token

# Development only: a Calendar API stub to talk to instead of Google, for an
# end-to-end check of a release binary (pair it with TOKEN_URI on the same
# stub). Only 127.0.0.1, localhost or [::1] is accepted; anything else
# refuses the start. Unset means Google (https://www.googleapis.com/calendar/v3).
# ALMANAC_GOOGLE_API_BASE=http://127.0.0.1:9100/calendar/v3

# Encrypts the per-source tokens at rest (AR17). 64 hex characters:
#   openssl rand -hex 32
# It must stay stable: change it and every issued token becomes
# unreadable, which shows up as every source getting a 401. Almanac
# now checks at startup that this key actually opens the store rather
# than discovering it one request at a time.
ALMANAC_SECRET_KEY=

# The login token (a chassis-rs knob, at least 16 characters): logs in on
# /login and works as a bearer token for the operator's own scripts.
# Required. It replaces ALMANAC_BOOTSTRAP_TOKEN, which a start now refuses
# with the rename spelled out; ALMANAC_CAPTURE_TOKEN is no longer read
# (a system that posts events gets a client token from the Sources page).
ALMANAC_TOKEN=


# ---------------------------------------------------------------- #
# Addresses — not secret; live in the unit file.                    #
# ---------------------------------------------------------------- #

# Who installs updates: off | supervised | autonomous. Unset means off.
# The compose file sets off, because a container discards a replaced
# binary on the next recreation (AR20); inside an OCI container autonomous
# is switched off by the kit anyway. The 2.x ALMANAC_SELF_UPDATE is still
# honoured with a warning (on/true/1/yes = autonomous, anything else = off).
ALMANAC_UPDATE_MODE=

# Where releases are published: the directory holding VERSION and
# SHA256SUMS. Unset derives it from the repository
# (https://github.com/kennypassenier/almanac/releases/latest/download).
# A 2.x value ending in /releases is rewritten to /releases/latest/download
# with a warning.
# ALMANAC_UPDATE_URL=

# Home Assistant's homelab-ops webhook (AR27). Where a reverted
# update, a release that fails verification, and a journal backlog are
# reported. Unset means those events only reach the log.
#
# A SECRET, despite being a URL: the webhook id is the only thing
# authenticating a caller to that automation, so anyone holding it can
# forge homelab events and pre-acknowledge real alerts. It belongs in
# Latch, never in this repository — which is public.
ALMANAC_NOTIFY_WEBHOOK=

# Where the listener binds. The default is 0.0.0.0:8080. The 2.x name
# ALMANAC_BIND is still honoured with a warning.
ALMANAC_LISTEN=

# Log filter (tracing syntax, for example "info"). RUST_LOG is read as a
# fallback.
ALMANAC_LOG=

# Who a new calendar is shared with (an account address, not a secret).
# Needed by "Make and share" on the Calendars page and by the
# create_calendars example; without it a calendar the service account
# creates stays invisible to everyone else.
ALMANAC_CALENDAR_OWNER=

# One heartbeat line in the log per interval, in seconds. Default 3600,
# 0 turns it off.
# ALMANAC_HEARTBEAT_INTERVAL_SECS=3600

# The state root. Profiles live in <root>/profiles and durable state
# (almanac.db with the journal, tokens.json, the update state, the lock) in <root>/data.
# Unset means the working directory; the unit file sets an absolute path
# under /opt/almanac. The 2.x per-path overrides ALMANAC_PROFILES_DIR,
# ALMANAC_DATA_DIR, ALMANAC_JOURNAL and ALMANAC_TOKEN_STORE still work and
# win over the root, but are deprecated. ALMANAC_JOURNAL now only names the
# legacy journal.jsonl that the first start imports into almanac.db.
ALMANAC_STATE_DIR=
